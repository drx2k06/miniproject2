# Environment Configuration Template for CrediEdge AI
# Copy this file to .env and adjust variables as required for your environment.

# Server and Dashboard Settings
CREDIEDGE_PORT=8501
CREDIEDGE_HOST=0.0.0.0
CREDIEDGE_ENV=development

# Underwriting Policy Thresholds
CREDIEDGE_MIN_CIBIL_CUTOFF=550
CREDIEDGE_PRIME_CIBIL_CUTOFF=720
CREDIEDGE_MAX_DTI_HARD_CAP=0.65
CREDIEDGE_TARGET_DTI_CAP=0.45

# Model and Data Paths
CREDIEDGE_MODEL_PATH=artifacts/gradient_boosting.joblib
CREDIEDGE_DATA_PATH=data/credit_dataset.csv
CREDIEDGE_RANDOM_SEED=42
